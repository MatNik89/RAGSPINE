{
  "manifest_version": 3,
  "name": "RAGSPINE Bridge",
  "version": "1.0",
  "description": "Polls the RAGSPINE browser bridge and executes browser actions on its behalf.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
